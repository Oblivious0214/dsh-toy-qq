{
  "name": "dsh-qq-skin",
  "description": "QQ 聊天界面，内置对话分段、头像背景和 Fish TTS 语音显示适配。",
  "version": "0.2.0-toy.7",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "qq"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oblivious0214/dsh-toy-qq.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-attachment"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "README.zh.md",
    "RELEASE.md",
    "RELEASING.md",
    "assets/chat-segments.png",
    "assets/voice.png",
    "docs/README.previous.md",
    "THIRD_PARTY_NOTICES.md",
    "VALIDATION.md",
    "locale",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "SEGMENTS-THIRD-PARTY-NOTICES.txt",
    "docs/segments-attribution.md",
    "docs/segments-LICENSE.txt",
    "vendor/dialogue-timing",
    "lib/vendor/dialogue-timing"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "node scripts/build-segments-worker.mjs && node scripts/copy-dialogue-timing.mjs && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-store": "workspace:~",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:~",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "18.3.0",
    "happy-dom": "^20.12.2",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "esbuild": "0.25.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:^",
    "@deepseek-ai/dsh-client-ui-attachment": "workspace:^"
  },
  "license": "MIT",
  "dependencies": {
    "cropperjs": "1.6.2",
    "react": "^18.2.0"
  },
  "homepage": "https://github.com/Oblivious0214/dsh-toy-qq#readme",
  "bugs": {
    "url": "https://github.com/Oblivious0214/dsh-toy-qq/issues"
  }
}
